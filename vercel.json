{
  "ignoreCommand": "node tools/check-syntax.js && exit 1 || exit 0",
  "routes": [
    { "src": "^/api/(.*)$", "has": [{ "type": "host", "value": "((www\\.)?bplending\\.com|bplending-preview\\.vercel\\.app)" }], "dest": "/api/$1" },
    { "src": "^/lp/(.*)$", "has": [{ "type": "host", "value": "((www\\.)?bplending\\.com|bplending-preview\\.vercel\\.app)" }], "dest": "/lp/$1" },
    { "src": "^/assets/(.*)$", "has": [{ "type": "host", "value": "((www\\.)?bplending\\.com|bplending-preview\\.vercel\\.app)" }], "dest": "/assets/$1" },
    { "src": "^/funded/?$", "has": [{ "type": "host", "value": "((www\\.)?bplending\\.com|bplending-preview\\.vercel\\.app)" }], "dest": "/api/funded" },
    { "src": "^/funded/([a-z0-9-]+)/?$", "has": [{ "type": "host", "value": "((www\\.)?bplending\\.com|bplending-preview\\.vercel\\.app)" }], "dest": "/api/funded?slug=$1" },
    { "src": "^/funded-sitemap\\.xml$", "has": [{ "type": "host", "value": "((www\\.)?bplending\\.com|bplending-preview\\.vercel\\.app)" }], "dest": "/api/funded?view=sitemap" },
    { "src": "^/$", "has": [{ "type": "host", "value": "((www\\.)?bplending\\.com|bplending-preview\\.vercel\\.app)" }], "dest": "/site-prod/index.html" },
    { "src": "^/(.+\\.[A-Za-z0-9]+)$", "has": [{ "type": "host", "value": "((www\\.)?bplending\\.com|bplending-preview\\.vercel\\.app)" }], "dest": "/site-prod/$1" },
    { "src": "^/(.+?)/?$", "has": [{ "type": "host", "value": "((www\\.)?bplending\\.com|bplending-preview\\.vercel\\.app)" }], "dest": "/site-prod/$1/index.html" }
  ]
}